# OpenAI-compatible API. Any provider that speaks the OpenAI API works.
OPENAI_API_KEY=sk-...
# Optional. Blank / omitted = https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Optional. Chat-memory database file (Mastra LibSQL store).
# Default: <editor root>/.ai-live/mastra.db
# AI_LIVE_STORAGE=/path/to/mastra.db
