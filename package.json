{
  "name": "ai-live-editor",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/vite-plugin/aiLiveEditor.ts"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:built": "AI_LIVE_UI=build tsx src/server.ts",
    "dev:self": "AI_LIVE_SELF=1 tsx src/server.ts",
    "dev:pool": "PLAYWRIGHT_POOL=1 LIVE_TARGET=pool tsx src/server.ts",
    "projects:dev": "cd projects/lumen && npm run dev",
    "launcher": "tsx src/server.ts",
    "benchmark": "tsx src/benchmarks/runCli.ts",
    "dev:all": "tsx src/server.ts",
    "ui:dev": "vite --port 3000",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "install:browser": "npx playwright install chromium",
    "install:all": "npm install && cd projects/lumen && npm install"
  },
  "dependencies": {
    "@mastra/core": "^1.0.0",
    "@mastra/libsql": "^1.29.0",
    "@mastra/memory": "^1.41.0",
    "@monaco-editor/react": "^4.6.0",
    "acorn": "^8.19.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.45.0",
    "playwright": "^1.64.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/devtools-kit": "0.8.2",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.5"
  }
}
