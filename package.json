{
  "name": "ai-live-editor-launcher",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:all": "concurrently \"tsx src/server.ts\" \"npm run projects:dev\"",
    "projects:dev": "cd projects && npm run dev",
    "ui:dev": "vite --port 3000",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "ext:dev": "cd extension && npm run dev",
    "ext:build": "cd extension && npm run build",
    "install:browser": "npx playwright install chromium",
    "install:all": "npm install && cd extension && npm install && cd .. && cd projects && npm install && cd .."
  },
  "dependencies": {
    "@mastra/core": "^1.0.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "chokidar": "^3.6.0",
    "playwright": "^1.48.0",
    "zod": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/devtools-kit": "0.8.2",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.5"
  }
}
